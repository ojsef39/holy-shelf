{
  "name": "holy-shelf",
  "private": true,
  "type": "module",
  "description": "Unofficial browser extension adding flavor lists to holy.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ojsef39/holy-shelf.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "web-ext run --source-dir src --target firefox-desktop --url https://de.holy.com/pages/account#lists",
    "lint": "web-ext lint --source-dir src",
    "icons": "node scripts/icons.mjs",
    "prestart": "npm run icons",
    "prelint": "npm run icons",
    "prebuild": "npm run icons",
    "presign": "npm run icons",
    "build": "web-ext build --source-dir src --overwrite-dest",
    "sign": "web-ext sign --source-dir src --channel listed"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "semantic-release": "^25.0.9",
    "sharp": "^0.35.4",
    "web-ext": "^10.6.0"
  }
}
